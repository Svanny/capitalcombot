{
  "name": "capitalcombot",
  "version": "0.1.0",
  "description": "Electron desktop app for Capital.com instrument trading, primarily optimized for Gold workflows, with scheduled orders and protection strategies.",
  "author": {
    "name": "Svanny",
    "email": "svanny@users.noreply.github.com"
  },
  "homepage": "https://github.com/Svanny/capitalcombot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Svanny/capitalcombot.git"
  },
  "bugs": {
    "url": "https://github.com/Svanny/capitalcombot/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:plain": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "package:mac": "bash scripts/package-mac.sh",
    "package:linux": "bash scripts/package-linux.sh",
    "package:win:native": "node scripts/package-win-native.mjs",
    "package:win": "bash scripts/package-win-docker.sh",
    "package:all": "pnpm package:mac && pnpm package:win",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/space-grotesk": "5.2.10",
    "electron-store": "11.0.2",
    "keytar": "7.9.0",
    "98.css": "0.1.21",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "42.0.1",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "jsdom": "29.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion": "5.0.6",
      "fast-uri": "3.1.2",
      "ip-address": "10.2.0",
      "lodash": "4.18.1",
      "picomatch": "4.0.4",
      "postcss": "8.5.14"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "keytar"
    ]
  }
}
